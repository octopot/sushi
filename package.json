{
  "name": "sushi",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && tsc --noEmit -p docs/demo && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build --bundles app",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:local": "npm test && cargo test --manifest-path src-tauri/Cargo.toml --release -- --include-ignored"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.5",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
